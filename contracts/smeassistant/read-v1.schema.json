        }
      }
    }
  ],
  "$defs": {
    "OfferEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offerId",
        "revision",
        "hash",
        "sourceLocationId",
        "appliedLocationId",
        "title",
        "details",
        "terms",
        "validFrom",
        "validUntil",
        "priceAmount",
        "currency",
        "claims",
        "prohibitedTerms",
        "observedAt",
        "sourceStatus",
        "rightsState"
      ],
      "properties": {
        "offerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceLocationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "appliedLocationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "terms": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        },
        "validFrom": {
          "type": "string",
          "format": "date"
        },
        "validUntil": {
          "type": "string",
          "format": "date"
        },
        "priceAmount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,2})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "enum": [
                "HKD",
                "TWD"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 20,
          "minItems": 0,
          "uniqueItems": true
        },
        "prohibitedTerms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 20,
          "minItems": 0,
          "uniqueItems": true
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceStatus": {
          "enum": [
            "confirmed",
            "expired",
            "archived"
          ]
        },
        "rightsState": {
          "const": "unverified_for_kinnso_reuse"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "priceAmount": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "currency": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "currency": {
                "enum": [
                  "HKD",
                  "TWD"
                ]
              }
            }
          }
        }
      ]
    },
    "sme_connection_status_v1_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "sme_connection_status_v1_result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
