      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "input",
        "result"
      ],
      "properties": {
        "tool": {
          "const": "sme_confirmed_offers_v1"
        },
        "input": {
          "$ref": "#/$defs/sme_confirmed_offers_v1_input"
        },
        "result": {
          "$ref": "#/$defs/sme_confirmed_offers_v1_result"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "input",
        "result"
      ],
      "properties": {
        "tool": {
