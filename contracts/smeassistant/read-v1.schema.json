        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "requestId",
            "observedAt",
            "scope",
            "data",
            "warnings"
          ],
          "properties": {
            "schemaVersion": {
              "const": "kinnso.sme.read.v1"
            },
            "status": {
              "enum": [
                "ready",
                "empty",
                "partial"
              ]
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workspaceId",
                "locationId",
                "scopeVersion"
              ],
              "properties": {
                "workspaceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "locationId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "scopeVersion": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "scopes",
                "scopeVersion",
                "locationIds",
                "lastVerifiedAt"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "active",
                    "reconnect",
                    "revoked",
                    "unverified"
                  ]
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "maxItems": 10,
                  "minItems": 0,
                  "uniqueItems": true
                },
                "scopeVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "locationIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "maxItems": 20,
                  "minItems": 0,
                  "uniqueItems": true
                },
                "lastVerifiedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "field": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              "maxItems": 20,
              "minItems": 0,
              "uniqueItems": true
            }
          }
        }
      ]
    },
