{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kinnso:sme:read:v1",
  "title": "Kinnso SME read v1 local contract; not MCP protocol acceptance",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "input",
        "result"
      ],
      "properties": {
        "tool": {
          "const": "sme_connection_status_v1"
        },
        "input": {
          "$ref": "#/$defs/sme_connection_status_v1_input"
        },
        "result": {
          "$ref": "#/$defs/sme_connection_status_v1_result"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "input",
        "result"
      ],
      "properties": {
        "tool": {
          "const": "sme_link_attestation_v1"
        },
        "input": {
          "$ref": "#/$defs/sme_link_attestation_v1_input"
        },
        "result": {
          "$ref": "#/$defs/sme_link_attestation_v1_result"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
