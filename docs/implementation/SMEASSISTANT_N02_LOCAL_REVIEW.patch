+const compiled=await build({entryPoints:[fileURLToPath(new URL('../repositories/mcp-read.ts',import.meta.url))],bundle:true,write:false,format:'esm',platform:'node'});
+const {createMcpReadRepository}=await import('data:text/javascript;base64,'+Buffer.from(compiled.outputFiles[0].text).toString('base64'));
+const stored={id:'offer',workspaceId:'workspace',locationId:null,title:'Sample',details:'Sample terms',terms:'Sample terms',revision:1,validFrom:'2026-11-01',validUntil:'2026-11-30',priceAmount:'1234.56',currency:'HKD',claims:[],prohibitedTerms:[],status:'confirmed',expired:false};
