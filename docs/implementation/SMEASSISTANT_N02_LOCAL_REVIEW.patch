@@ -0,0 +1,6 @@
+/** G3 remains closed: no selected issuer/audience, official SDK transport or live verifier.
+ * Never infer MCP authorization from the website session or an environment flag. */
+const unavailable=()=>Response.json({status:'unavailable',code:'MCP_NOT_CONFIGURED'},{status:503,headers:{'Cache-Control':'private, no-store'}});
+export const GET=unavailable;
+export const POST=unavailable;
+export const DELETE=unavailable;
