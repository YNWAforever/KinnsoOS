new file mode 100644
--- /dev/null
+++ b/lib/mcp/authorize.ts
@@ -0,0 +1,16 @@
+import type {AuthVerifier,ReadRepository,Principal,ToolName} from './contracts';
+import {locations} from './contracts';
+export interface AuthPolicy {issuer:string;audience:string;clock:()=>number}
+export async function authorize(request:Request,tool:ToolName,input:Record<string,unknown>,verifier:AuthVerifier,repository:ReadRepository,policy:AuthPolicy):Promise<Principal>{
+ const claims=await verifier.verify(request);
+ if(!claims)throw Error('NOT_CONNECTED');
+ if(!policy.issuer||!policy.audience||claims.issuer!==policy.issuer||claims.audience!==policy.audience||!claims.subject||!claims.workspaceId||!claims.tokenId||!Number.isFinite(claims.expiresAt)||claims.expiresAt<=policy.clock())throw Error('FORBIDDEN');
+ const membership=await repository.membership(claims.subject,claims.workspaceId);
+ if(!membership?.active)throw Error('FORBIDDEN');
+ if(!Number.isSafeInteger(membership.scopeVersion)||membership.scopeVersion<1)throw Error('UNAVAILABLE');
+ const required=tool==='sme_link_attestation_v1'?['link:attest']:tool==='sme_merchant_context_v1'?['merchant:read']:tool==='sme_offer_evidence_v1'?['offers:read','evidence:read']:tool==='sme_connection_status_v1'?[]:['offers:read'];
+ if(required.some(s=>!claims.scopes.includes(s))||tool==='sme_link_attestation_v1'&&membership.role!=='owner')throw Error('FORBIDDEN');
+ if(claims.expiresAt<=policy.clock()||locations(input).some(id=>!membership.locationIds.includes(id)))throw Error('FORBIDDEN');
+ return {...claims,...membership};
+}
+export function samePrincipal(a:Principal,b:Principal){return a.subject===b.subject&&a.workspaceId===b.workspaceId&&a.tokenId===b.tokenId&&a.scopeVersion===b.scopeVersion&&a.role===b.role&&JSON.stringify([...a.locationIds].sort())===JSON.stringify([...b.locationIds].sort())&&JSON.stringify([...a.scopes].sort())===JSON.stringify([...b.scopes].sort());}
