   };
 }
 
+/** Bounded MCP reads preserve the database decimal string; no provider execution.
+ * Call only after current membership/location authorization. */
+export function offerMcpReadRepository(client?: Pick<Pool, "query">) {
+ const db=()=>client??getPool();
+ const map=(row:OfferRow)=>({...toOffer(row),priceAmount:row.price_amount});
+ return {
+  async page(workspaceId:string,locationId:string,afterId:string|null,limit:number){
+   if(!Number.isInteger(limit)||limit<1||limit>50)throw new Error('INVALID');
+   if(afterId!==null&&!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(afterId))throw new Error('INVALID');
+   const {rows}=await db().query<OfferRow>(`SELECT ${columns('')} FROM offers WHERE workspace_id=$1 AND (location_id=$2 OR location_id IS NULL)
+    AND status='confirmed' AND NOT public.offer_is_expired(valid_until,workspace_id) AND ($3::uuid IS NULL OR id>$3::uuid) ORDER BY id LIMIT $4`,[workspaceId,locationId,afterId,limit+1]);
+   return {items:rows.slice(0,limit).map(map),nextCursor:rows.length>limit?rows[limit-1].id:null};
+  },
+  async evidence(workspaceId:string,locationId:string,offerId:string){
+   const {rows}=await db().query<OfferRow>(`SELECT ${columns('')} FROM offers WHERE workspace_id=$1 AND id=$2 AND (location_id=$3 OR location_id IS NULL) AND status<>'draft'`,[workspaceId,offerId,locationId]);
+   return rows[0]?map(rows[0]):null;
+  }
+ };
+}
+
 export type OfferRepository = ReturnType<typeof offerRepository>;
