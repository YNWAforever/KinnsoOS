+++ b/lib/mcp/contracts.ts
@@ -0,0 +1,52 @@
+/** Kinnso read-v1 transport-independent contract. No token or provider credentials in results. */
+export const SCHEMA='kinnso.sme.read.v1' as const;
+export const TOOL_NAMES=['sme_connection_status_v1','sme_link_attestation_v1','sme_merchant_context_v1','sme_confirmed_offers_v1','sme_offer_evidence_v1','sme_validate_offer_refs_v1'] as const;
+export type ToolName=typeof TOOL_NAMES[number];
+export type ErrorCode='NOT_CONNECTED'|'FORBIDDEN'|'UNAVAILABLE'|'SOURCE_CHANGED'|'INVALID'|'RATE_LIMITED'|'TIMEOUT'|'UNSUPPORTED';
+export type TokenClaims={subject:string;issuer:string;audience:string;workspaceId:string;scopes:string[];expiresAt:number;tokenId:string};
+export type Membership={role:'owner'|'manager'|'viewer';locationIds:string[];scopeVersion:number;active:boolean};
+export type Principal=TokenClaims&Membership;
+export interface AuthVerifier {verify(request:Request):Promise<TokenClaims|null>}
+export interface ScopeRepository {membership(subject:string,workspaceId:string):Promise<Membership|null>}
+export type OfferEvidence={offerId:string;revision:number;hash:string;sourceLocationId:string|null;appliedLocationId:string;title:string;details:string;terms:string;validFrom:string;validUntil:string;priceAmount:string|null;currency:'HKD'|'TWD'|null;claims:string[];prohibitedTerms:string[];observedAt:string;sourceStatus:'confirmed'|'expired'|'archived';rightsState:'unverified_for_kinnso_reuse'};
+export type MerchantContext={publicName:string;websiteUrl:string|null;market:string;locationId:string;availableFields:string[];observedAt:string};
+export interface ReadRepository extends ScopeRepository {
+ context(principal:Principal,locationId:string):Promise<MerchantContext|null>;
+ offers(principal:Principal,locationId:string,cursor:string|null,limit:number):Promise<{items:OfferEvidence[];nextCursor:string|null}>;
+ evidence(principal:Principal,locationId:string,offerId:string):Promise<OfferEvidence|null>;
+}
+export interface LinkAttestor {
+ /** Must atomically consume a server-issued, company-bound nonce in a durable store.
+  * Signed proof binds issuer/audience/workspace/scopeVersion/locations/company/nonce/expiry.
+  * No production implementation is selected or wired in this candidate. */
+ issue(principal:Principal,input:{nonce:string;companyBindingHash:string;locationIds:string[]}):Promise<{proof:string;expiresAt:string}>;
+}
+export function record(value:unknown,required:string[],optional:string[]=[]):Record<string,unknown>{
+ if(!value||typeof value!=='object'||Array.isArray(value)||Object.getPrototypeOf(value)!==Object.prototype)throw Error('INVALID');
+ const r=value as Record<string,unknown>;
+ if(required.some(k=>!Object.hasOwn(r,k))||Object.keys(r).some(k=>![...required,...optional].includes(k)))throw Error('INVALID');return r;
+}
+export function text(v:unknown,max=200):string{if(typeof v!=='string'||!v.trim()||v.length>max||/[\u0000-\u001f]/.test(v))throw Error('INVALID');return v;}
+export function positive(v:unknown,max=100000000):number{if(!Number.isSafeInteger(v)||Number(v)<1||Number(v)>max)throw Error('INVALID');return v as number;}
+export function parseInput(tool:ToolName,value:unknown):Record<string,unknown>{
+ if(!TOOL_NAMES.includes(tool))throw Error('UNSUPPORTED');
+ const fields:Record<ToolName,[string[],string[]?]>={sme_connection_status_v1:[[]],sme_link_attestation_v1:[['nonce','companyBindingHash','locationIds']],sme_merchant_context_v1:[['locationId','locale']],sme_confirmed_offers_v1:[['locationId'],['cursor','limit']],sme_offer_evidence_v1:[['offerId','expectedRevision','locationId']],sme_validate_offer_refs_v1:[['refs']]};
+ const [req,opt]=fields[tool],r=record(value,req,opt);
+ if(r.locationId!==undefined)text(r.locationId);
+ if(r.offerId!==undefined)text(r.offerId);
+ if(r.expectedRevision!==undefined)positive(r.expectedRevision);
+ if(r.cursor!==undefined)text(r.cursor,300);
+ if(r.limit!==undefined)positive(r.limit,50);
+ if(r.locale!==undefined&&!['en','zh-HK','zh-TW'].includes(String(r.locale)))throw Error('INVALID');
+ if(tool==='sme_link_attestation_v1'){
+  if(!/^[A-Za-z0-9_-]{43}$/.test(text(r.nonce))||!/^[a-f0-9]{64}$/.test(text(r.companyBindingHash)))throw Error('INVALID');
+  if(!Array.isArray(r.locationIds)||!r.locationIds.length||r.locationIds.length>20||new Set(r.locationIds).size!==r.locationIds.length)throw Error('INVALID');r.locationIds.forEach(x=>text(x));
+ }
+ if(tool==='sme_validate_offer_refs_v1'){
+  if(!Array.isArray(r.refs)||!r.refs.length||r.refs.length>20)throw Error('INVALID');
+  const ids=new Set<string>();for(const item of r.refs){const ref=record(item,['offerId','revision','hash','locationId']);text(ref.offerId);text(ref.locationId);positive(ref.revision);if(!/^[a-f0-9]{64}$/.test(text(ref.hash)))throw Error('INVALID');
+   const key=ref.offerId+':'+ref.locationId;if(ids.has(key))throw Error('INVALID');ids.add(key);
+  }
+ }return r;
+}
+export function locations(input:Record<string,unknown>):string[]{return input.locationId?[String(input.locationId)]:Array.isArray(input.locationIds)?input.locationIds as string[]:Array.isArray(input.refs)?input.refs.map(r=>(r as {locationId:string}).locationId):[];}
