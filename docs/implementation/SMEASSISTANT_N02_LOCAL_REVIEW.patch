+import {createHash} from 'node:crypto';
+import type {Principal,ReadRepository,OfferEvidence} from '../mcp/contracts';
+type Member={role:'owner'|'manager'|'viewer';location_scope:string[]|null;accepted_at:string|null};
+export type StoredOffer={id:string;workspaceId:string;locationId:string|null;title:string;details:string;terms:string;revision:number;validFrom:string;validUntil:string;priceAmount:string|null;currency:'HKD'|'TWD'|null;claims:string[];prohibitedTerms:string[];status:'draft'|'confirmed'|'archived';expired:boolean};
+export interface RepositoryPorts {
+ members:{accepted:(user:string,workspace:string)=>Promise<Member|null>;locationIds:(workspace:string)=>Promise<string[]>};
+ offers:{page:(workspace:string,location:string,cursor:string|null,limit:number)=>Promise<{items:StoredOffer[];nextCursor:string|null}>;evidence:(workspace:string,location:string,id:string)=>Promise<StoredOffer|null>};
+ workspaces:{workspaces:(ids:string[])=>Promise<{id:string;business_name:string|null;market:string|null}[]>};
+ /** Persisted monotonic epoch tied to this exact membership fingerprint. Missing = unavailable.
+  * No production epoch store is selected in this local candidate. */
+ scopeEpoch:(subject:string,workspace:string,fingerprint:string)=>Promise<number|null>;
+ clock:()=>number;
+}
+const hash=(value:unknown)=>createHash('sha256').update(JSON.stringify(value)).digest('hex');
+export function createMcpReadRepository(ports:RepositoryPorts):ReadRepository {
+ const evidence=(row:StoredOffer,p:Principal,location:string):OfferEvidence=>{
+  if(row.workspaceId!==p.workspaceId||row.locationId!==null&&row.locationId!==location||row.status==='draft')throw Error('FORBIDDEN');
+  // Source hash excludes application location and observation time: one workspace offer,
+  // separate Kinnso publications/rights per applied location.
+  const facts={offerId:row.id,revision:row.revision,sourceLocationId:row.locationId,title:row.title,details:row.details,terms:row.terms,validFrom:row.validFrom,validUntil:row.validUntil,priceAmount:row.priceAmount,currency:row.currency,claims:row.claims,prohibitedTerms:row.prohibitedTerms};
+  return {...facts,hash:hash(facts),sourceStatus:row.status==='archived'?'archived':row.expired?'expired':'confirmed',appliedLocationId:location,observedAt:new Date(ports.clock()).toISOString(),rightsState:'unverified_for_kinnso_reuse'};
+ };
+ return {
+  async membership(subject,workspace){
+   const member=await ports.members.accepted(subject,workspace);if(!member?.accepted_at)return null;
+   const all=await ports.members.locationIds(workspace),locations=(member.location_scope===null?all:all.filter(id=>member.location_scope!.includes(id))).sort();
+   const fingerprint=hash({subject,workspace,role:member.role,acceptedAt:member.accepted_at,locations});
+   const scopeVersion=await ports.scopeEpoch(subject,workspace,fingerprint);
+   if(scopeVersion===null||!Number.isSafeInteger(scopeVersion)||scopeVersion<1)throw Error('UNAVAILABLE');
+   return {role:member.role,locationIds:locations,scopeVersion,active:true};
+  },
+  async context(p,location){
+   if(!p.locationIds.includes(location))throw Error('FORBIDDEN');const rows=await ports.workspaces.workspaces([p.workspaceId]),row=rows.find(w=>w.id===p.workspaceId);if(!row?.business_name?.trim()||!row.market?.trim())return null;
+   return {publicName:row.business_name,market:row.market,websiteUrl:null,locationId:location,availableFields:['publicName','market'],observedAt:new Date(ports.clock()).toISOString()};
+  },
+  async offers(p,location,cursor,limit){if(!p.locationIds.includes(location))throw Error('FORBIDDEN');const page=await ports.offers.page(p.workspaceId,location,cursor,limit);return {items:page.items.map(row=>evidence(row,p,location)),nextCursor:page.nextCursor};},
+  async evidence(p,location,id){if(!p.locationIds.includes(location))throw Error('FORBIDDEN');const row=await ports.offers.evidence(p.workspaceId,location,id);return row?evidence(row,p,location):null;}
+ };
+}
