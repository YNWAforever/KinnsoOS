# One explicitly approved backend identity per environment, shared with the legacy app.
# Use a publishable key or legacy anon JWT. NEVER a service-role or secret key.
KINNSO_SUPABASE_URL=
KINNSO_SUPABASE_PUBLISHABLE_KEY=
KINNSO_ENVIRONMENT=local
KINNSO_APPROVED_SUPABASE_ORIGIN=
KINNSO_LEGACY_AUTH_ORIGIN=
KINNSO_ENABLED_CAPABILITIES=
# Approved private service origin is required for verified media and shared photos.
KINNSO_SERVICES_ORIGIN=
KINNSO_APPROVED_SERVICES_ORIGIN=
# Set to your own deployment origin. No original Sites identity is inherited.
KINNSO_SITE_URL=http://localhost:3000
