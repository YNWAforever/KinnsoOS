# One explicitly approved backend identity per environment, shared with the legacy app.
# Use a publishable key or legacy anon JWT. NEVER a service-role or secret key.
KINNSO_SUPABASE_URL=
KINNSO_SUPABASE_PUBLISHABLE_KEY=
KINNSO_ENVIRONMENT=local
KINNSO_APPROVED_SUPABASE_ORIGIN=
KINNSO_LEGACY_AUTH_ORIGIN=
KINNSO_ENABLED_CAPABILITIES=
# Approved private service origin is required for verified media and shared photos.
# Choose "unified" to reuse the mature server media module in this application.
# Keep the secret server-only. It must belong to the approved backend above.
KINNSO_MEDIA_RUNTIME=
KINNSO_SUPABASE_SECRET_KEY=
# Server-only random token (at least 32 characters) for the cleanup endpoint.
CRON_SECRET=
KINNSO_SERVICES_ORIGIN=
KINNSO_APPROVED_SERVICES_ORIGIN=
# Set to your own deployment origin. No original Sites identity is inherited.
KINNSO_SITE_URL=http://localhost:3000
# Canonical origin serving the published guide/experience source routes.
# Missing or invalid origin disables source recommendations; no paid AI transport is configured.
KINNSO_CANONICAL_SOURCE_ORIGIN=

# Server-only random value >=32 characters; stable across deployment instances.
# Rotation invalidates pending 15-minute recovery tickets. Never use NEXT_PUBLIC_.
KINNSO_AUTH_RECOVERY_SECRET=
