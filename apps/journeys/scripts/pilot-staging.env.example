# PREPARATION ONLY; not auto-loaded. Selected original backend; bounded cohort required.
# No new Supabase projects, cloud resets or production-variable changes.
# Blank means unavailable; do not copy global privileged secrets into this file.
KINNSO_ENVIRONMENT=staging
KINNSO_SUPABASE_URL=
KINNSO_APPROVED_SUPABASE_ORIGIN=
KINNSO_LEGACY_AUTH_ORIGIN=
