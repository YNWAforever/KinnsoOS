{
  "name": "kinnso-os",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "pnpm --filter @kinnso/journeys dev",
    "build": "node scripts/ensure-db-types.mjs && turbo run build",
    "lint": "eslint . && turbo run lint",
    "honesty:lint": "tsx scripts/honesty-lint.ts",
    "typecheck": "node scripts/ensure-db-types.mjs && turbo run typecheck",
    "test": "node --test tooling-tests/*.test.mjs && turbo run test",
    "dev:web": "pnpm --filter web dev --port 3001",
    "test:journeys": "pnpm --filter @kinnso/journeys test",
    "test:integration": "pnpm --filter @kinnso/journeys test:integration",
    "test:e2e": "pnpm --filter @kinnso/journeys test:e2e",
    "db:types": "node --env-file=apps/web/.env.test scripts/gen-kinnso-local-types.mjs",
    "source:pack": "pnpm --filter @kinnso/journeys source:pack",
    "start": "pnpm --filter @kinnso/journeys start",
    "start:web": "pnpm --filter web start --port 3001"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@kinnso/honesty": "workspace:*",
    "eslint": "^9.39.4",
    "supabase": "^2.106.0",
    "turbo": "^2.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
